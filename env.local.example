# Локальные настройки для тестирования
# Скопируйте этот файл в .env и заполните своими данными

# Токен тестового бота (создайте через @BotFather)
TEST_BOT_TOKEN=your_test_bot_token_here

# Настройки для локального тестирования
CACHE_DURATION=10
RATE_LIMIT_COOLDOWN=5
DATABASE_PATH=test_bot_database.db
CACHE_DIRECTORY=test_cache

# Для локального тестирования PostgreSQL не нужен
# Используется SQLite
